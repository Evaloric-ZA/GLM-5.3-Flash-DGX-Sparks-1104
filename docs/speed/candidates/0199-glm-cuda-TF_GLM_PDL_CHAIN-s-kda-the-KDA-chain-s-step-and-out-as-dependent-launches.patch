@@ -72,18 +82,20 @@ pub fn chainSegs(ks: *const Kernels, stream: cuda.Stream, c: Chain, t: *const Se
     for ([_]u64{ c.conv_w, c.a_log, c.dt_bias }) |v| a.add(v);
