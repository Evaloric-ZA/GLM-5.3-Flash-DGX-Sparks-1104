+    try cuda.launch.launch(if (ks.pdl) ks.step_segs_p else ks.step_segs, .{ .grid = .{ .x = @intCast(c.heads), .y = dv / 4 / 8, .z = z }, .block = .{ .x = 8 * 32 }, .pdl = ks.pdl }, stream, &b);
