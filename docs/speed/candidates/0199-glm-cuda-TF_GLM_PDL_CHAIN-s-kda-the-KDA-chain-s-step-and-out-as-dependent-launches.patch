From 1f951858ecfcab2e62397e474f04d534045d794d Mon Sep 17 00:00:00 2001
From: MiaAI_Lab <mia.ailab1@gmail.com>
Date: Wed, 4 Nov 2026 10:56:04 +0200
Subject: [PATCH] glm-cuda: TF_GLM_PDL_CHAIN's kda (opt-in by name) - the KDA
 chain's step and out as dependent launches (the same bits)

KDA C1 as measured, not as planned. The handoff's "merge the verify chain's three launches" was benchmarked on an idle
GB10 (docs/speed/kda-c1/bench_kda_c1.cu, 34 layers each with its own 2 MiB states, 60 reps x 2 passes, every output
byte-compared): prep fused into step loses (every step block recomputes the head's prep: 33 -> 39 us a layer at 2
rows, 44 -> 79 at 8), the single fused kernel is no better than three launches at any row count, and the chain's
floor is its state bytes (15 us a layer lone, 61 us at 4 segments) against 33-100 us measured. The one scheduling form
that wins standalone is the three kernels unchanged as programmatic dependent launches: -5 to -7 us a layer with prep
launched plainly (-7 to -10 with prep dependent too), bit-identical in every cell.

In the engine (image 45a1d17d74d7, pair A, TF_GLM_PROF=1, OFF/ON/OFF/ON, 2026-11-04): hashes unchanged in every leg,
throughput within noise, and the kda section moved -0.13 ms then +0.06 ms at verify 2 rows and nowhere at the shared
8-13 row windows - below the section's own 0.19 ms run-to-run spread. The pre-registered SHIP-OFF rule fired: `kda`
is NOT in Chain.all; it takes effect only when named (TF_GLM_PDL_CHAIN=reduce,hc,p2p,moe,kda).

- glm_kda.cu: tf_glm_kda_prep_p (waits, then triggers, at entry), tf_glm_kda_step_p/step4_p/step2_p (the state
  slice loads before the wait - this layer's state, written long before prep - prep's rows after it, then the
  trigger), tf_glm_kda_out_p (the gate row and the norm weight load before the wait, the read-out after; no
  trigger, so the o_proj after it starts when out has finished), and the _segs_p forms with every CTA waiting
  before it exits. step_kernel_body gains a PDL template parameter (false for the existing kernels: the same code).
- cuda_kda.zig: Kernels.pdl from TF_GLM_PDL_CHAIN's new member kda; with it chain and chainSegs launch the _p
  kernels, step and out with the attribute. prep launches plainly even then: the glm_mm matmul before it triggers
  early (qmm_frag.cuh) and 512-thread prep CTAs waiting on its tail would hold its slots; prep_p's own trigger still
  lets step launch early.
- cuda_mm.zig: Chain.kda, parsed by name, not in `all`; a host test of the parse.

Record: docs/speed/RESULTS.md 2026-11-04 (bench, gate, legs); Codex consult docs/speed/codex-kda-c1.md.

---
 zig/kernels/cuda/glm_kda.cu       | 115 +++++++++++++++++++++++++++++-
 zig/src/families/glm/cuda_kda.zig |  37 +++++++---
 zig/src/families/glm/cuda_mm.zig  |  17 ++++-
 3 files changed, 154 insertions(+), 15 deletions(-)

diff --git a/zig/kernels/cuda/glm_kda.cu b/zig/kernels/cuda/glm_kda.cu
index 90310dc43..c73af0f1e 100644
--- a/zig/kernels/cuda/glm_kda.cu
+++ b/zig/kernels/cuda/glm_kda.cu
@@ -15,6 +15,19 @@ using tf_common::warp_sum;
 
 using tf_common::sigmoidf_;
 
+// Programmatic dependent launch (as glm_triton.cuh's): a `_p` kernel waits before it reads another grid's data or
+// writes anything, and before any exit, then lets the next grid launch; without the launch attribute both are no-ops.
+__device__ __forceinline__ void pdl_wait() {
+#if __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.wait;" ::: "memory");
+#endif
+}
+__device__ __forceinline__ void pdl_trigger() {
+#if __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+#endif
+}
+
 // One delta-rule step on this thread's 4 x 4 block of the state: per-channel decay, read (k), correct toward v.
 __device__ __forceinline__ void update(float (&s)[4][4], const float (&kk)[4], const float (&gg)[4],
                                        const float* vrow, int warp, float beta) {
@@ -294,7 +307,8 @@ __device__ __forceinline__ void update4(float (&s)[4][4], const float (&kk)[4],
 }
 
 // Block (head, part): a warp owns 4 value rows; TR rows of saved k, q, decay, v, beta staged in smem at a time.
-template <int WARPS, int TR>
+// PDL: prep's dependent - the state (this layer's, written long before prep) loads before the wait, prep's rows after.
+template <int WARPS, int TR, bool PDL = false>
 __device__ __forceinline__ void step_kernel_body(
         int H, const float* __restrict__ state_in, const float* __restrict__ q_in, const float* __restrict__ k_save,
         const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
@@ -313,6 +327,10 @@ __device__ __forceinline__ void step_kernel_body(
     for (int j = 0; j < 4; ++j)
 #pragma unroll
         for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    if (PDL) {
+        pdl_wait();
+        pdl_trigger();
+    }
     for (int r0 = 0; r0 < rows; r0 += TR) {
         const int n = rows - r0 < TR ? rows - r0 : TR;
         __syncthreads();
@@ -380,6 +398,32 @@ __device__ __forceinline__ void out_kernel_body(
     out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
 }
 
+// out_kernel_body as step's dependent: the gate (the projection's row, complete before the chain's first kernel began)
+// and the norm weight load before the wait, the read-out after it; the same operands, so the same bits. No trigger:
+// what follows the chain (an o_proj that may itself launch as a dependent) starts when out has finished.
+__device__ __forceinline__ void out_p_kernel_body(
+        int H, const __nv_bfloat16* __restrict__ y_in, const __nv_bfloat16* __restrict__ G, int g_stride,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, __nv_bfloat16* __restrict__ out) {
+    const int r = blockIdx.x, h = blockIdx.y;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float rinv;
+    const size_t base = ((size_t)r * H + h) * DV;
+    const float gate = __bfloat162float(G[(size_t)r * g_stride + h * DV + t]);
+    const float nw = __bfloat162float(norm_w[t]);
+    pdl_wait();
+    if (warp == 0) {
+        float ss = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { const float y = __bfloat162float(y_in[base + lane * 4 + i]); ss = ss + y * y; }
+        ss = warp_sum(ss);
+        if (lane == 0) rinv = 1.0f / sqrtf(ss / (float)DV + eps);
+    }
+    __syncthreads();
+    const float yn = __bfloat162float(y_in[base + t]) * rinv;
+    const float yw = nw * yn;
+    out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
+}
+
 }  // namespace
 
 extern "C" __global__ void __launch_bounds__(1024) tf_glm_kda_chain(
@@ -448,6 +492,48 @@ extern "C" __global__ void __launch_bounds__(128) tf_glm_kda_out(
     out_kernel_body(H, y_in, G, g_stride, norm_w, eps, out);
 }
 
+// The chain as dependent launches (cuda_kda's Kernels.pdl, TF_GLM_PDL_CHAIN's kda): the same bodies, so the same bits.
+// prep waits at its entry (its inputs are the projection's rows), step after its state load, out after its gate load.
+// Measured on GB10 against the plain chain, 34 layers: -7 to -9 us a layer at 1-11 rows and at 4 segments of 2-4.
+extern "C" __global__ void __launch_bounds__(512) tf_glm_kda_prep_p(
+        int H, const __nv_bfloat16* __restrict__ P, int p_stride, int b_off, const __nv_bfloat16* __restrict__ A,
+        int a_stride, const __nv_bfloat16* __restrict__ cs, const float* __restrict__ cw,
+        const float* __restrict__ a_log, const float* __restrict__ dt_bias, float lower, float* __restrict__ q_out,
+        float* __restrict__ k_save, __nv_bfloat16* __restrict__ v_save, float* __restrict__ g_save,
+        float* __restrict__ b_save) {
+    pdl_wait();
+    pdl_trigger();
+    prep_kernel_body(
+        H, P, p_stride, b_off, A, a_stride, cs, cw, a_log, dt_bias, lower, q_out, k_save, v_save, g_save, b_save);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_glm_kda_step_p(
+        int H, const float* __restrict__ state_in, const float* __restrict__ q_in, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        int rows, __nv_bfloat16* __restrict__ y_out, float* __restrict__ state_out) {
+    step_kernel_body<8, 16, true>(H, state_in, q_in, k_save, v_save, g_save, b_save, rows, y_out, state_out);
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_glm_kda_step4_p(
+        int H, const float* __restrict__ state_in, const float* __restrict__ q_in, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        int rows, __nv_bfloat16* __restrict__ y_out, float* __restrict__ state_out) {
+    step_kernel_body<4, 16, true>(H, state_in, q_in, k_save, v_save, g_save, b_save, rows, y_out, state_out);
+}
+
+extern "C" __global__ void __launch_bounds__(64) tf_glm_kda_step2_p(
+        int H, const float* __restrict__ state_in, const float* __restrict__ q_in, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        int rows, __nv_bfloat16* __restrict__ y_out, float* __restrict__ state_out) {
+    step_kernel_body<2, 16, true>(H, state_in, q_in, k_save, v_save, g_save, b_save, rows, y_out, state_out);
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_glm_kda_out_p(
+        int H, const __nv_bfloat16* __restrict__ y_in, const __nv_bfloat16* __restrict__ G, int g_stride,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, __nv_bfloat16* __restrict__ out) {
+    out_p_kernel_body(H, y_in, G, g_stride, norm_w, eps, out);
+}
+
 // A shared window's KDA layer with every segment (stream) in one launch: z picks the segment, and each block is the
 // block that segment's own tf_glm_kda_prep / _step / _out launch runs, on its rows, states and saves (their q and y
 // rows at the segment's own offset in the window's scratch), so the bits are the per-segment launches'.
@@ -492,3 +578,30 @@ extern "C" __global__ void __launch_bounds__(128) tf_glm_kda_out_segs(
     if (static_cast<int>(blockIdx.x) >= g.rows) return;
     out_kernel_body(H, g.y, g.G, g_stride, norm_w, eps, g.out);
 }
+
+// The segs forms as dependent launches (as the _p kernels above); every CTA waits before it exits.
+extern "C" __global__ void __launch_bounds__(512) tf_glm_kda_prep_segs_p(
+        int H, int p_stride, int b_off, int a_stride, const float* __restrict__ cw, const float* __restrict__ a_log,
+        const float* __restrict__ dt_bias, float lower, const KdaSegs t) {
+    pdl_wait();
+    pdl_trigger();
+    const KdaSeg& g = t.s[blockIdx.z];
+    if (static_cast<int>(blockIdx.x) >= g.rows) return;
+    prep_kernel_body(H, g.P, p_stride, b_off, g.A, a_stride, g.cs, cw, a_log, dt_bias, lower, g.q, g.k_save, g.v_save,
+                     g.g_save, g.b_save);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_glm_kda_step_segs_p(int H, const KdaSegs t) {
+    const KdaSeg& g = t.s[blockIdx.z];
+    step_kernel_body<8, 16, true>(H, g.state_in, g.q, g.k_save, g.v_save, g.g_save, g.b_save, g.rows, g.y, g.state_out);
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_glm_kda_out_segs_p(
+        int H, int g_stride, const __nv_bfloat16* __restrict__ norm_w, float eps, const KdaSegs t) {
+    const KdaSeg& g = t.s[blockIdx.z];
+    if (static_cast<int>(blockIdx.x) >= g.rows) {
+        pdl_wait();
+        return;
+    }
+    out_p_kernel_body(H, g.y, g.G, g_stride, norm_w, eps, g.out);
+}
