-    try cuda.launch.launch(ks.prep_segs, .{ .grid = .{ .x = @intCast(most), .y = @intCast(c.heads), .z = z }, .block = .{ .x = 512 } }, stream, &a);
+    // prep launches plainly even with pdl (the matmul before it triggers early, qmm_frag.cuh, and 512-thread CTAs
