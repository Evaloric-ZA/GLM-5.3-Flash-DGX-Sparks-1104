+        inline for (.{ "chain", "replay", "replay_layers", "prep", "step", "step4", "step2", "out", "prep_segs", "step_segs", "out_segs", "prep_p", "step_p", "step4_p", "step2_p", "out_p", "prep_segs_p", "step_segs_p", "out_segs_p" }) |name| @field(k, name) = try m.function("tf_glm_kda_" ++ name);
